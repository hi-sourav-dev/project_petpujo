      border: none;
      border-radius: 4px;
      cursor: pointer;
      margin-top: 16px;
    }
    #submit:hover {
      background: linear-gradient(to right, #4F46E5, #1E40AF);
    }
      .password-wrapper input {
    padding-right: 40px;
    }

  .toggle-password {
    position: absolute;
    width: auto;
    top: 0;
    left: 17rem;
    transform: translateY(-50%);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    fill: #e0e0e0;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  </style><div class="container">  
    <h2>Admin Login</h2>  
    <form action="/adminPortal" id="admin-signup-form" method="post">  
      <input placeholder="Username" type="text" name="Username" required>  
      <input placeholder="User ID" type="text"  name="userId" required>  
      <input placeholder="Email address" type="email" name="email" required>  
      <!-- <input placeholder="Password" type="password" name="password" required>   -->
        <div class="password-wrapper" style="position: relative;">
        <input placeholder="Password" type="password" id="real-password" name="password" required style="padding-right: 40px;" />
          <button type="button" class="toggle-password" onclick="togglePassword('real-password')">
            <svg id="eye" style="display: none;" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" width="20" height="20">
