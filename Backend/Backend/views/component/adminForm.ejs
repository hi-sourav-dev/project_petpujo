<style>
    body {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background-color: #121212;
      font-family: Arial, sans-serif;
    }
    .container {
      width: 100%;
      max-width: 400px;
      /* background-color: #2D2D2D; */
      background: rgba(45, 45, 45,0.9);
      border-radius: 8px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.7);
      padding: 24px;
    }
    h2 {
      color: #E0E0E0;
      margin-bottom: 16px;
      font-size: 24px;
      font-weight: bold;
    }
    input {
      width: 100%;
      background-color: #3D3D3D;
      color: #E0E0E0;
      border: none;
      border-radius: 4px;
      padding: 10px;
      margin-bottom: 16px;
    }
    input:focus {
      background-color: #4D4D4D;
      outline: none;
      border: 1px solid #3B82F6;
    }
    label {
      color: #E0E0E0;
      margin-bottom: 14px;
      font-size: 0.8rem;
    }
    .checkbox-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .checkbox-container label {
      font-size: 0.8rem;
      margin-bottom: 0;
    }
    .checkbox-container input {
      margin-bottom: 0;
    }
    .checkbox-container .remember {
      display: flex;
      justify-content: space-between;
      align-items: center;
      white-space: nowrap;
      gap: 0.5rem;
    }
    .checkbox-container a {
      color: #3B82F6;
      text-decoration: none;
      font-size: 14px;
    }
    .checkbox-container a:hover {
      text-decoration: underline;
    }
    .signup-text {
      color: #E0E0E0;
      margin-top: 1rem;
      font-size: 0.9rem;
    }
    .signup-text a {
      color: #3B82F6;
